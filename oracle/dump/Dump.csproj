<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Дамп-хук: выгружает промежуточные значения расчёта сложности в JSON.
    Дев-инструмент для сверки Python-порта. Запиненный клон ppy/osu НЕ патчится:
    всё берётся через подкласс OsuDifficultyCalculator (см. Program.cs).

    Ссылка на PerformanceCalculator даёт ProcessorWorkingBeatmap (загрузка .osu)
    и транзитивно osu.Game со всеми рулсетами. Это Exe-проект, поэтому явно
    фиксируем свою точку входа.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Dump</AssemblyName>
    <RootNamespace>Dump</RootNamespace>
    <StartupObject>Dump.Program</StartupObject>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../osu-tools/PerformanceCalculator/PerformanceCalculator.csproj" />
  </ItemGroup>

</Project>
